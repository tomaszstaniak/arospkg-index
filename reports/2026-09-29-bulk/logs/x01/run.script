; Batch script for one test machine; run with Execute RAM:b/run
FAILAT 1000
Protect RAM:b/apkg +e
Protect RAM:b/putfile +e
MakeDir RAM:L
Echo >RAM:L/net.txt "network"
Lab net
RAM:b/putfile >RAM:L/netlog RAM:L/net.txt net.txt 8801
If WARN
  Wait 10
  Skip net BACK
EndIf
Echo >RAM:L/env.txt "apkg:"
List >>RAM:L/env.txt RAM:b/apkg LFORMAT="%n %l"
RAM:b/apkg >>RAM:L/env.txt --version
Version >>RAM:L/env.txt
Date >>RAM:L/env.txt
Avail >>RAM:L/env.txt
Stack >>RAM:L/env.txt
RAM:b/putfile >NIL: RAM:L/env.txt env.txt 8801
Echo >RAM:L/a.txt "==== stage A: install"
Echo >>RAM:L/a.txt "*N==== scummvm"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install scummvm
Echo >>RAM:L/a.txt "install scummvm: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info scummvm
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8801
Echo >RAM:L/b-scummvm.txt "==== scummvm: scummvm, stack 262144"
Date >>RAM:L/b-scummvm.txt
If NOT EXISTS SYS:Batch/scummvm
  Echo >>RAM:L/b-scummvm.txt "scummvm: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start scummvm "SYS:Batch/scummvm" "scummvm" 262144
  Wait 15
  Echo >>RAM:L/b-scummvm.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-scummvm.txt COMMAND="scummvm"
  If EXISTS RAM:L/r-scummvm.txt
    Type >>RAM:L/b-scummvm.txt RAM:L/r-scummvm.txt
  EndIf
EndIf
Echo >RAM:L/m "scummvm"
RAM:b/putfile >NIL: RAM:L/m shot-scummvm 8801
Wait 4
Status >NIL: COMMAND="scummvm"
If NOT WARN
  Break >NIL: `Status COMMAND="scummvm"` C
  Wait 5
EndIf
Echo >>RAM:L/b-scummvm.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-scummvm.txt COMMAND="scummvm"
If EXISTS RAM:L/r-scummvm.txt
  Type >>RAM:L/b-scummvm.txt RAM:L/r-scummvm.txt
EndIf
Date >>RAM:L/b-scummvm.txt
RAM:b/putfile >NIL: RAM:L/b-scummvm.txt b-scummvm.txt 8801
If EXISTS RAM:L/o-scummvm.txt
RAM:b/putfile >NIL: RAM:L/o-scummvm.txt o-scummvm.txt 8801
EndIf
RAM:b/putfile >NIL: RAM:L/m done-scummvm 8801
Wait 3
Echo >RAM:L/c.txt "==== stage C: remove"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove scummvm
Echo >>RAM:L/c.txt "remove scummvm: rc=$RC"
Echo >>RAM:L/c.txt "*N==== List SYS:Batch ALL"
List >>RAM:L/c.txt SYS:Batch ALL
Echo >>RAM:L/c.txt "*N==== apkg list"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch list
Date >>RAM:L/c.txt
RAM:b/putfile >NIL: RAM:L/c.txt c.txt 8801
Echo >RAM:L/end.txt "end"
RAM:b/putfile >NIL: RAM:L/end.txt end.txt 8801

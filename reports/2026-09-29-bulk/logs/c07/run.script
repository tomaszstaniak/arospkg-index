Echo >RAM:L/b-amishockolate.txt "==== amishockolate: AmiShockolate, stack 40960"
Date >>RAM:L/b-amishockolate.txt
If NOT EXISTS SYS:Batch/amishockolate
  Echo >>RAM:L/b-amishockolate.txt "amishockolate: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start amishockolate "SYS:Batch/amishockolate" AmiShockolate 40960
  Wait 15
  Echo >>RAM:L/b-amishockolate.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-amishockolate.txt COMMAND=AmiShockolate
  If EXISTS RAM:L/r-amishockolate.txt
    Type >>RAM:L/b-amishockolate.txt RAM:L/r-amishockolate.txt
  EndIf
EndIf
Echo >RAM:L/m "amishockolate"
RAM:b/putfile >NIL: RAM:L/m shot-amishockolate 8807
Wait 4
Status >NIL: COMMAND=AmiShockolate
If NOT WARN
  Break >NIL: `Status COMMAND=AmiShockolate` C
  Wait 5
EndIf
Echo >>RAM:L/b-amishockolate.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-amishockolate.txt COMMAND=AmiShockolate
If EXISTS RAM:L/r-amishockolate.txt
  Type >>RAM:L/b-amishockolate.txt RAM:L/r-amishockolate.txt
EndIf
Date >>RAM:L/b-amishockolate.txt
RAM:b/putfile >NIL: RAM:L/b-amishockolate.txt b-amishockolate.txt 8807
If EXISTS RAM:L/o-amishockolate.txt
RAM:b/putfile >NIL: RAM:L/o-amishockolate.txt o-amishockolate.txt 8807
EndIf
RAM:b/putfile >NIL: RAM:L/m done-amishockolate 8807
Wait 3

  Status >>RAM:L/b-sploiner.txt COMMAND=Sploiner
  If EXISTS RAM:L/r-sploiner.txt
    Type >>RAM:L/b-sploiner.txt RAM:L/r-sploiner.txt
  EndIf
EndIf
Echo >RAM:L/m "sploiner"
RAM:b/putfile >NIL: RAM:L/m shot-sploiner 8809
Wait 4
Status >NIL: COMMAND=Sploiner
If NOT WARN
  Break >NIL: `Status COMMAND=Sploiner` C
  Wait 5
EndIf
Echo >>RAM:L/b-sploiner.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-sploiner.txt COMMAND=Sploiner
If EXISTS RAM:L/r-sploiner.txt
  Type >>RAM:L/b-sploiner.txt RAM:L/r-sploiner.txt
EndIf
Date >>RAM:L/b-sploiner.txt
RAM:b/putfile >NIL: RAM:L/b-sploiner.txt b-sploiner.txt 8809
If EXISTS RAM:L/o-sploiner.txt
RAM:b/putfile >NIL: RAM:L/o-sploiner.txt o-sploiner.txt 8809
EndIf
RAM:b/putfile >NIL: RAM:L/m done-sploiner 8809
Wait 3
Echo >RAM:L/b-tiltnroll.txt "==== tiltnroll: Tilt-N-Roll, stack 40960"
Date >>RAM:L/b-tiltnroll.txt
If NOT EXISTS SYS:Batch/tiltnroll

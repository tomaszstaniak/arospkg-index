Echo >>RAM:L/a.txt "install zapperng: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info zapperng
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8805
Echo >RAM:L/b-adoom3.txt "==== adoom3: ADoom3, stack 10000000"
Date >>RAM:L/b-adoom3.txt
If NOT EXISTS SYS:Batch/adoom3
  Echo >>RAM:L/b-adoom3.txt "adoom3: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start adoom3 "SYS:Batch/adoom3" ADoom3 10000000
  Wait 15
  Echo >>RAM:L/b-adoom3.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-adoom3.txt COMMAND=ADoom3
  If EXISTS RAM:L/r-adoom3.txt
    Type >>RAM:L/b-adoom3.txt RAM:L/r-adoom3.txt
  EndIf
EndIf
Echo >RAM:L/m "adoom3"
RAM:b/putfile >NIL: RAM:L/m shot-adoom3 8805
Wait 4
Status >NIL: COMMAND=ADoom3
If NOT WARN
  Break >NIL: `Status COMMAND=ADoom3` C
  Wait 5
EndIf
Echo >>RAM:L/b-adoom3.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-adoom3.txt COMMAND=ADoom3
If EXISTS RAM:L/r-adoom3.txt
  Type >>RAM:L/b-adoom3.txt RAM:L/r-adoom3.txt
EndIf
Date >>RAM:L/b-adoom3.txt
RAM:b/putfile >NIL: RAM:L/b-adoom3.txt b-adoom3.txt 8805
If EXISTS RAM:L/o-adoom3.txt
RAM:b/putfile >NIL: RAM:L/o-adoom3.txt o-adoom3.txt 8805
EndIf
RAM:b/putfile >NIL: RAM:L/m done-adoom3 8805
Wait 3
Echo >RAM:L/b-boy.txt "==== boy: Boy, stack 50000"
Date >>RAM:L/b-boy.txt
If NOT EXISTS SYS:Batch/boy
  Echo >>RAM:L/b-boy.txt "boy: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start boy "SYS:Batch/boy" Boy 50000
  Wait 15
  Echo >>RAM:L/b-boy.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-boy.txt COMMAND=Boy
  If EXISTS RAM:L/r-boy.txt
    Type >>RAM:L/b-boy.txt RAM:L/r-boy.txt
  EndIf
EndIf
Echo >RAM:L/m "boy"
RAM:b/putfile >NIL: RAM:L/m shot-boy 8805
Wait 4
Status >NIL: COMMAND=Boy
If NOT WARN
  Break >NIL: `Status COMMAND=Boy` C
  Wait 5
EndIf
Echo >>RAM:L/b-boy.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-boy.txt COMMAND=Boy
If EXISTS RAM:L/r-boy.txt
  Type >>RAM:L/b-boy.txt RAM:L/r-boy.txt
EndIf
Date >>RAM:L/b-boy.txt
RAM:b/putfile >NIL: RAM:L/b-boy.txt b-boy.txt 8805
If EXISTS RAM:L/o-boy.txt
RAM:b/putfile >NIL: RAM:L/o-boy.txt o-boy.txt 8805
EndIf
RAM:b/putfile >NIL: RAM:L/m done-boy 8805

Else
  Run >NIL: <NIL: Execute RAM:b/start tiltnroll "SYS:Batch/tiltnroll" Tilt-N-Roll 40960
  Wait 15
  Echo >>RAM:L/b-tiltnroll.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-tiltnroll.txt COMMAND=Tilt-N-Roll
  If EXISTS RAM:L/r-tiltnroll.txt
    Type >>RAM:L/b-tiltnroll.txt RAM:L/r-tiltnroll.txt
  EndIf
EndIf
Echo >RAM:L/m "tiltnroll"
RAM:b/putfile >NIL: RAM:L/m shot-tiltnroll 8809
Wait 4
Status >NIL: COMMAND=Tilt-N-Roll
If NOT WARN
  Break >NIL: `Status COMMAND=Tilt-N-Roll` C
  Wait 5
EndIf
Echo >>RAM:L/b-tiltnroll.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-tiltnroll.txt COMMAND=Tilt-N-Roll
If EXISTS RAM:L/r-tiltnroll.txt
  Type >>RAM:L/b-tiltnroll.txt RAM:L/r-tiltnroll.txt
EndIf
Date >>RAM:L/b-tiltnroll.txt
RAM:b/putfile >NIL: RAM:L/b-tiltnroll.txt b-tiltnroll.txt 8809
If EXISTS RAM:L/o-tiltnroll.txt
RAM:b/putfile >NIL: RAM:L/o-tiltnroll.txt o-tiltnroll.txt 8809
EndIf
RAM:b/putfile >NIL: RAM:L/m done-tiltnroll 8809

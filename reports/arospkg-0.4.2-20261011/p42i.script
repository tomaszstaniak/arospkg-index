FAILAT 1000
Delete RAM:su RAM:cat ALL FORCE QUIET
MakeDir RAM:su
MakeDir RAM:cat
Copy SYS:P42/apkg041 RAM:su/apkg
Protect RAM:su/apkg +e
RAM:su/apkg --version >RESULTS:p42i-01-version041.txt
Echo >>RESULTS:p42i-01-version041.txt "rc=$RC"
RAM:su/apkg self-update --check >RESULTS:p42i-02-check.txt
Echo >>RESULTS:p42i-02-check.txt "rc=$RC"
RAM:su/apkg --plain self-update >RESULTS:p42i-03-selfupdate.txt
Echo >>RESULTS:p42i-03-selfupdate.txt "rc=$RC"
RAM:su/apkg --version >RESULTS:p42i-04-version.txt
Echo >>RESULTS:p42i-04-version.txt "rc=$RC"
RAM:su/apkg --root RAM:cat --index SYS:P42/index-v2.json --plain install arospkg >RESULTS:p42i-05-install.txt
Echo >>RESULTS:p42i-05-install.txt "rc=$RC"
RAM:cat/arospkg/apkg --version >RESULTS:p42i-06-started.txt
Echo >>RESULTS:p42i-06-started.txt "rc=$RC"
RAM:su/apkg --root RAM:cat --index SYS:P42/index-v2.json verify arospkg >RESULTS:p42i-07-verify.txt
Echo >>RESULTS:p42i-07-verify.txt "rc=$RC"
RAM:su/apkg --root RAM:cat --index SYS:P42/index-v2.json remove arospkg >RESULTS:p42i-08-remove.txt
Echo >>RESULTS:p42i-08-remove.txt "rc=$RC"
Echo >RESULTS:p42i-done.txt "done"

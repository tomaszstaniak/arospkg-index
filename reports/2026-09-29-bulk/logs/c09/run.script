; Batch script for one test machine; run with Execute RAM:b/run
FAILAT 1000
Protect RAM:b/apkg +e
Protect RAM:b/putfile +e
MakeDir RAM:L
Echo >RAM:L/net.txt "network"
Lab net
RAM:b/putfile >RAM:L/netlog RAM:L/net.txt net.txt 8809
If WARN
  Wait 10
  Skip net BACK
EndIf
Echo >RAM:L/env.txt "apkg:"
List >>RAM:L/env.txt RAM:b/apkg LFORMAT="%n %l"
RAM:b/apkg >>RAM:L/env.txt --version
Version >>RAM:L/env.txt
Date >>RAM:L/env.txt
Avail >>RAM:L/env.txt
Stack >>RAM:L/env.txt
RAM:b/putfile >NIL: RAM:L/env.txt env.txt 8809
Echo >RAM:L/a.txt "==== stage A: install"
Echo >>RAM:L/a.txt "*N==== alac"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install alac
Echo >>RAM:L/a.txt "install alac: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info alac
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8809
Echo >>RAM:L/a.txt "*N==== amiberry"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install amiberry

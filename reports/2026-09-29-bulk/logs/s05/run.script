; Batch script for one test machine; run with Execute RAM:b/run
FAILAT 1000
Protect RAM:b/apkg +e
Protect RAM:b/putfile +e
MakeDir RAM:L
Echo >RAM:L/net.txt "network"
Lab net
RAM:b/putfile >RAM:L/netlog RAM:L/net.txt net.txt 8805
If WARN
  Wait 10
  Skip net BACK
EndIf
Echo >RAM:L/env.txt "apkg:"
List >>RAM:L/env.txt RAM:b/apkg LFORMAT="%n %l"
RAM:b/apkg >>RAM:L/env.txt --version
Version >>RAM:L/env.txt
Date >>RAM:L/env.txt
Avail >>RAM:L/env.txt
Stack >>RAM:L/env.txt
RAM:b/putfile >NIL: RAM:L/env.txt env.txt 8805
Echo >RAM:L/a.txt "==== stage A: install"
Echo >>RAM:L/a.txt "*N==== csid"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install csid
Echo >>RAM:L/a.txt "install csid: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info csid
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8805
Echo >>RAM:L/a.txt "*N==== ffmpegaudioextractor"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install ffmpegaudioextractor
Echo >>RAM:L/a.txt "install ffmpegaudioextractor: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info ffmpegaudioextractor
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8805
Echo >>RAM:L/a.txt "*N==== gnurobbo"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install gnurobbo
Echo >>RAM:L/a.txt "install gnurobbo: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info gnurobbo
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8805
Echo >>RAM:L/a.txt "*N==== minislug"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install minislug
Echo >>RAM:L/a.txt "install minislug: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info minislug
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8805
Echo >>RAM:L/a.txt "*N==== planethively"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install planethively
Echo >>RAM:L/a.txt "install planethively: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info planethively
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8805
Echo >>RAM:L/a.txt "*N==== siddump"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install siddump
Echo >>RAM:L/a.txt "install siddump: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info siddump
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8805
Echo >>RAM:L/a.txt "*N==== targa_datatype"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install targa_datatype
Echo >>RAM:L/a.txt "install targa_datatype: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info targa_datatype
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8805
Echo >RAM:L/b-csid.txt "==== csid: cSID, stack 40960"
Date >>RAM:L/b-csid.txt
If NOT EXISTS SYS:Batch/csid
  Echo >>RAM:L/b-csid.txt "csid: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start csid "SYS:Batch/csid/cSID-PlaySID-GUI" cSID 40960
  Wait 15
  Echo >>RAM:L/b-csid.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-csid.txt COMMAND=cSID
  If EXISTS RAM:L/r-csid.txt
    Type >>RAM:L/b-csid.txt RAM:L/r-csid.txt
  EndIf
EndIf
Echo >RAM:L/m "csid"
RAM:b/putfile >NIL: RAM:L/m shot-csid 8805
Wait 4
Status >NIL: COMMAND=cSID
If NOT WARN
  Break >NIL: `Status COMMAND=cSID` C
  Wait 5
EndIf
Echo >>RAM:L/b-csid.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-csid.txt COMMAND=cSID
If EXISTS RAM:L/r-csid.txt
  Type >>RAM:L/b-csid.txt RAM:L/r-csid.txt
EndIf
Date >>RAM:L/b-csid.txt
RAM:b/putfile >NIL: RAM:L/b-csid.txt b-csid.txt 8805
If EXISTS RAM:L/o-csid.txt
RAM:b/putfile >NIL: RAM:L/o-csid.txt o-csid.txt 8805
EndIf
RAM:b/putfile >NIL: RAM:L/m done-csid 8805
Wait 3
Echo >RAM:L/b-ffmpegaudioextractor.txt "==== ffmpegaudioextractor: FFmpegAudioExtractor.exe, stack 40960"
Date >>RAM:L/b-ffmpegaudioextractor.txt
If NOT EXISTS SYS:Batch/ffmpegaudioextractor
  Echo >>RAM:L/b-ffmpegaudioextractor.txt "ffmpegaudioextractor: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start ffmpegaudioextractor "SYS:Batch/ffmpegaudioextractor" FFmpegAudioExtractor.exe 40960
  Wait 15
  Echo >>RAM:L/b-ffmpegaudioextractor.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-ffmpegaudioextractor.txt COMMAND=FFmpegAudioExtractor.exe
  If EXISTS RAM:L/r-ffmpegaudioextractor.txt
    Type >>RAM:L/b-ffmpegaudioextractor.txt RAM:L/r-ffmpegaudioextractor.txt
  EndIf
EndIf
Echo >RAM:L/m "ffmpegaudioextractor"
RAM:b/putfile >NIL: RAM:L/m shot-ffmpegaudioextractor 8805
Wait 4
Status >NIL: COMMAND=FFmpegAudioExtractor.exe
If NOT WARN
  Break >NIL: `Status COMMAND=FFmpegAudioExtractor.exe` C
  Wait 5
EndIf
Echo >>RAM:L/b-ffmpegaudioextractor.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-ffmpegaudioextractor.txt COMMAND=FFmpegAudioExtractor.exe
If EXISTS RAM:L/r-ffmpegaudioextractor.txt
  Type >>RAM:L/b-ffmpegaudioextractor.txt RAM:L/r-ffmpegaudioextractor.txt
EndIf
Date >>RAM:L/b-ffmpegaudioextractor.txt
RAM:b/putfile >NIL: RAM:L/b-ffmpegaudioextractor.txt b-ffmpegaudioextractor.txt 8805
If EXISTS RAM:L/o-ffmpegaudioextractor.txt
RAM:b/putfile >NIL: RAM:L/o-ffmpegaudioextractor.txt o-ffmpegaudioextractor.txt 8805
EndIf
RAM:b/putfile >NIL: RAM:L/m done-ffmpegaudioextractor 8805
Wait 3
Echo >RAM:L/b-gnurobbo.txt "==== gnurobbo: GNURobbo, stack 40960"
Date >>RAM:L/b-gnurobbo.txt
If NOT EXISTS SYS:Batch/gnurobbo
  Echo >>RAM:L/b-gnurobbo.txt "gnurobbo: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start gnurobbo "SYS:Batch/gnurobbo" GNURobbo 40960
  Wait 15
  Echo >>RAM:L/b-gnurobbo.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-gnurobbo.txt COMMAND=GNURobbo
  If EXISTS RAM:L/r-gnurobbo.txt
    Type >>RAM:L/b-gnurobbo.txt RAM:L/r-gnurobbo.txt
  EndIf
EndIf
Echo >RAM:L/m "gnurobbo"
RAM:b/putfile >NIL: RAM:L/m shot-gnurobbo 8805
Wait 4
Status >NIL: COMMAND=GNURobbo
If NOT WARN
  Break >NIL: `Status COMMAND=GNURobbo` C
  Wait 5
EndIf
Echo >>RAM:L/b-gnurobbo.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-gnurobbo.txt COMMAND=GNURobbo
If EXISTS RAM:L/r-gnurobbo.txt
  Type >>RAM:L/b-gnurobbo.txt RAM:L/r-gnurobbo.txt
EndIf
Date >>RAM:L/b-gnurobbo.txt
RAM:b/putfile >NIL: RAM:L/b-gnurobbo.txt b-gnurobbo.txt 8805
If EXISTS RAM:L/o-gnurobbo.txt
RAM:b/putfile >NIL: RAM:L/o-gnurobbo.txt o-gnurobbo.txt 8805
EndIf
RAM:b/putfile >NIL: RAM:L/m done-gnurobbo 8805
Wait 3
Echo >RAM:L/b-minislug.txt "==== minislug: minislug, stack 40960"
Date >>RAM:L/b-minislug.txt
If NOT EXISTS SYS:Batch/minislug
  Echo >>RAM:L/b-minislug.txt "minislug: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start minislug "SYS:Batch/minislug" minislug 40960
  Wait 15
  Echo >>RAM:L/b-minislug.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-minislug.txt COMMAND=minislug
  If EXISTS RAM:L/r-minislug.txt
    Type >>RAM:L/b-minislug.txt RAM:L/r-minislug.txt
  EndIf
EndIf
Echo >RAM:L/m "minislug"
RAM:b/putfile >NIL: RAM:L/m shot-minislug 8805
Wait 4
Status >NIL: COMMAND=minislug
If NOT WARN
  Break >NIL: `Status COMMAND=minislug` C
  Wait 5
EndIf
Echo >>RAM:L/b-minislug.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-minislug.txt COMMAND=minislug
If EXISTS RAM:L/r-minislug.txt
  Type >>RAM:L/b-minislug.txt RAM:L/r-minislug.txt
EndIf
Date >>RAM:L/b-minislug.txt
RAM:b/putfile >NIL: RAM:L/b-minislug.txt b-minislug.txt 8805
If EXISTS RAM:L/o-minislug.txt
RAM:b/putfile >NIL: RAM:L/o-minislug.txt o-minislug.txt 8805
EndIf
RAM:b/putfile >NIL: RAM:L/m done-minislug 8805
Wait 3
Echo >RAM:L/b-planethively.txt "==== planethively: PlanetHively, stack 40960"
Date >>RAM:L/b-planethively.txt
If NOT EXISTS SYS:Batch/planethively
  Echo >>RAM:L/b-planethively.txt "planethively: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start planethively "SYS:Batch/planethively" PlanetHively 40960
  Wait 15
  Echo >>RAM:L/b-planethively.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-planethively.txt COMMAND=PlanetHively
  If EXISTS RAM:L/r-planethively.txt
    Type >>RAM:L/b-planethively.txt RAM:L/r-planethively.txt
  EndIf
EndIf
Echo >RAM:L/m "planethively"
RAM:b/putfile >NIL: RAM:L/m shot-planethively 8805
Wait 4
Status >NIL: COMMAND=PlanetHively
If NOT WARN
  Break >NIL: `Status COMMAND=PlanetHively` C
  Wait 5
EndIf
Echo >>RAM:L/b-planethively.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-planethively.txt COMMAND=PlanetHively
If EXISTS RAM:L/r-planethively.txt
  Type >>RAM:L/b-planethively.txt RAM:L/r-planethively.txt
EndIf
Date >>RAM:L/b-planethively.txt
RAM:b/putfile >NIL: RAM:L/b-planethively.txt b-planethively.txt 8805
If EXISTS RAM:L/o-planethively.txt
RAM:b/putfile >NIL: RAM:L/o-planethively.txt o-planethively.txt 8805
EndIf
RAM:b/putfile >NIL: RAM:L/m done-planethively 8805
Wait 3
Echo >RAM:L/b-siddump.txt "==== siddump: SidDump, stack 40960"
Date >>RAM:L/b-siddump.txt
If NOT EXISTS SYS:Batch/siddump
  Echo >>RAM:L/b-siddump.txt "siddump: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start siddump "SYS:Batch/siddump" SidDump 40960
  Wait 15
  Echo >>RAM:L/b-siddump.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-siddump.txt COMMAND=SidDump
  If EXISTS RAM:L/r-siddump.txt
    Type >>RAM:L/b-siddump.txt RAM:L/r-siddump.txt
  EndIf
EndIf
Echo >RAM:L/m "siddump"
RAM:b/putfile >NIL: RAM:L/m shot-siddump 8805
Wait 4
Status >NIL: COMMAND=SidDump
If NOT WARN
  Break >NIL: `Status COMMAND=SidDump` C
  Wait 5
EndIf
Echo >>RAM:L/b-siddump.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-siddump.txt COMMAND=SidDump
If EXISTS RAM:L/r-siddump.txt
  Type >>RAM:L/b-siddump.txt RAM:L/r-siddump.txt
EndIf
Date >>RAM:L/b-siddump.txt
RAM:b/putfile >NIL: RAM:L/b-siddump.txt b-siddump.txt 8805
If EXISTS RAM:L/o-siddump.txt
RAM:b/putfile >NIL: RAM:L/o-siddump.txt o-siddump.txt 8805
EndIf
RAM:b/putfile >NIL: RAM:L/m done-siddump 8805
Wait 3
Echo >RAM:L/b-targa_datatype.txt "==== targa_datatype: targa.datatype, stack 40960"
Date >>RAM:L/b-targa_datatype.txt
If NOT EXISTS SYS:Batch/targa_datatype
  Echo >>RAM:L/b-targa_datatype.txt "targa_datatype: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start targa_datatype "SYS:Batch/targa_datatype" targa.datatype 40960
  Wait 15
  Echo >>RAM:L/b-targa_datatype.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-targa_datatype.txt COMMAND=targa.datatype
  If EXISTS RAM:L/r-targa_datatype.txt
    Type >>RAM:L/b-targa_datatype.txt RAM:L/r-targa_datatype.txt
  EndIf
EndIf
Echo >RAM:L/m "targa_datatype"
RAM:b/putfile >NIL: RAM:L/m shot-targa_datatype 8805
Wait 4
Status >NIL: COMMAND=targa.datatype
If NOT WARN
  Break >NIL: `Status COMMAND=targa.datatype` C
  Wait 5
EndIf
Echo >>RAM:L/b-targa_datatype.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-targa_datatype.txt COMMAND=targa.datatype
If EXISTS RAM:L/r-targa_datatype.txt
  Type >>RAM:L/b-targa_datatype.txt RAM:L/r-targa_datatype.txt
EndIf
Date >>RAM:L/b-targa_datatype.txt
RAM:b/putfile >NIL: RAM:L/b-targa_datatype.txt b-targa_datatype.txt 8805
If EXISTS RAM:L/o-targa_datatype.txt
RAM:b/putfile >NIL: RAM:L/o-targa_datatype.txt o-targa_datatype.txt 8805
EndIf
RAM:b/putfile >NIL: RAM:L/m done-targa_datatype 8805
Wait 3
Echo >RAM:L/c.txt "==== stage C: remove"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove csid
Echo >>RAM:L/c.txt "remove csid: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove ffmpegaudioextractor
Echo >>RAM:L/c.txt "remove ffmpegaudioextractor: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove gnurobbo
Echo >>RAM:L/c.txt "remove gnurobbo: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove minislug
Echo >>RAM:L/c.txt "remove minislug: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove planethively
Echo >>RAM:L/c.txt "remove planethively: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove siddump
Echo >>RAM:L/c.txt "remove siddump: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove targa_datatype
Echo >>RAM:L/c.txt "remove targa_datatype: rc=$RC"
Echo >>RAM:L/c.txt "*N==== List SYS:Batch ALL"
List >>RAM:L/c.txt SYS:Batch ALL
Echo >>RAM:L/c.txt "*N==== apkg list"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch list
Date >>RAM:L/c.txt
RAM:b/putfile >NIL: RAM:L/c.txt c.txt 8805
Echo >RAM:L/end.txt "end"
RAM:b/putfile >NIL: RAM:L/end.txt end.txt 8805

; Batch script for one test machine; run with Execute RAM:b/run
FAILAT 1000
Protect RAM:b/apkg +e
Protect RAM:b/putfile +e
MakeDir RAM:L
Echo >RAM:L/net.txt "network"
Lab net
RAM:b/putfile >RAM:L/netlog RAM:L/net.txt net.txt 8803
If WARN
  Wait 10
  Skip net BACK
EndIf
Echo >RAM:L/env.txt "apkg:"
List >>RAM:L/env.txt RAM:b/apkg LFORMAT="%n %l"
RAM:b/apkg >>RAM:L/env.txt --version
Version >>RAM:L/env.txt
Date >>RAM:L/env.txt
Avail >>RAM:L/env.txt
Stack >>RAM:L/env.txt
RAM:b/putfile >NIL: RAM:L/env.txt env.txt 8803
Echo >RAM:L/a.txt "==== stage A: install"
Echo >>RAM:L/a.txt "*N==== zapperng"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install zapperng
Echo >>RAM:L/a.txt "install zapperng: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info zapperng
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8803
Echo >>RAM:L/a.txt "*N==== zgloom"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install zgloom
Echo >>RAM:L/a.txt "install zgloom: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info zgloom
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8803
Echo >>RAM:L/a.txt "*N==== zunearc"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install zunearc
Echo >>RAM:L/a.txt "install zunearc: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info zunearc
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8803
Echo >RAM:L/b-zapperng.txt "==== zapperng: ZapperNG, stack 40960"
Date >>RAM:L/b-zapperng.txt
If NOT EXISTS SYS:Batch/zapperng
  Echo >>RAM:L/b-zapperng.txt "zapperng: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start zapperng "SYS:Batch/zapperng" "ZapperNG" 40960
  Wait 15
  Echo >>RAM:L/b-zapperng.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-zapperng.txt COMMAND="ZapperNG"
  If EXISTS RAM:L/r-zapperng.txt
    Type >>RAM:L/b-zapperng.txt RAM:L/r-zapperng.txt
  EndIf
EndIf
Echo >RAM:L/m "zapperng"
RAM:b/putfile >NIL: RAM:L/m shot-zapperng 8803
Wait 4
Status >NIL: COMMAND="ZapperNG"
If NOT WARN
  Break >NIL: `Status COMMAND="ZapperNG"` C
  Wait 5
EndIf
Echo >>RAM:L/b-zapperng.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-zapperng.txt COMMAND="ZapperNG"
If EXISTS RAM:L/r-zapperng.txt
  Type >>RAM:L/b-zapperng.txt RAM:L/r-zapperng.txt
EndIf
Date >>RAM:L/b-zapperng.txt
RAM:b/putfile >NIL: RAM:L/b-zapperng.txt b-zapperng.txt 8803
If EXISTS RAM:L/o-zapperng.txt
RAM:b/putfile >NIL: RAM:L/o-zapperng.txt o-zapperng.txt 8803
EndIf
RAM:b/putfile >NIL: RAM:L/m done-zapperng 8803
Wait 3
Echo >RAM:L/b-zgloom.txt "==== zgloom: ZGloom, stack 200000"
Date >>RAM:L/b-zgloom.txt
If NOT EXISTS SYS:Batch/zgloom
  Echo >>RAM:L/b-zgloom.txt "zgloom: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start zgloom "SYS:Batch/zgloom" "ZGloom" 200000
  Wait 15
  Echo >>RAM:L/b-zgloom.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-zgloom.txt COMMAND="ZGloom"
  If EXISTS RAM:L/r-zgloom.txt
    Type >>RAM:L/b-zgloom.txt RAM:L/r-zgloom.txt
  EndIf
EndIf
Echo >RAM:L/m "zgloom"
RAM:b/putfile >NIL: RAM:L/m shot-zgloom 8803
Wait 4
Status >NIL: COMMAND="ZGloom"
If NOT WARN
  Break >NIL: `Status COMMAND="ZGloom"` C
  Wait 5
EndIf
Echo >>RAM:L/b-zgloom.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-zgloom.txt COMMAND="ZGloom"
If EXISTS RAM:L/r-zgloom.txt
  Type >>RAM:L/b-zgloom.txt RAM:L/r-zgloom.txt
EndIf
Date >>RAM:L/b-zgloom.txt
RAM:b/putfile >NIL: RAM:L/b-zgloom.txt b-zgloom.txt 8803
If EXISTS RAM:L/o-zgloom.txt
RAM:b/putfile >NIL: RAM:L/o-zgloom.txt o-zgloom.txt 8803
EndIf
RAM:b/putfile >NIL: RAM:L/m done-zgloom 8803
Wait 3
Echo >RAM:L/b-zunearc.txt "==== zunearc: ZuneARC, stack 40960"
Date >>RAM:L/b-zunearc.txt
If NOT EXISTS SYS:Batch/zunearc
  Echo >>RAM:L/b-zunearc.txt "zunearc: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start zunearc "SYS:Batch/zunearc" "ZuneARC" 40960
  Wait 15
  Echo >>RAM:L/b-zunearc.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-zunearc.txt COMMAND="ZuneARC"
  If EXISTS RAM:L/r-zunearc.txt
    Type >>RAM:L/b-zunearc.txt RAM:L/r-zunearc.txt
  EndIf
EndIf
Echo >RAM:L/m "zunearc"
RAM:b/putfile >NIL: RAM:L/m shot-zunearc 8803
Wait 4
Status >NIL: COMMAND="ZuneARC"
If NOT WARN
  Break >NIL: `Status COMMAND="ZuneARC"` C
  Wait 5
EndIf
Echo >>RAM:L/b-zunearc.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-zunearc.txt COMMAND="ZuneARC"
If EXISTS RAM:L/r-zunearc.txt
  Type >>RAM:L/b-zunearc.txt RAM:L/r-zunearc.txt
EndIf
Date >>RAM:L/b-zunearc.txt
RAM:b/putfile >NIL: RAM:L/b-zunearc.txt b-zunearc.txt 8803
If EXISTS RAM:L/o-zunearc.txt
RAM:b/putfile >NIL: RAM:L/o-zunearc.txt o-zunearc.txt 8803
EndIf
RAM:b/putfile >NIL: RAM:L/m done-zunearc 8803
Wait 3
Echo >RAM:L/c.txt "==== stage C: remove"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove zapperng
Echo >>RAM:L/c.txt "remove zapperng: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove zgloom
Echo >>RAM:L/c.txt "remove zgloom: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove zunearc
Echo >>RAM:L/c.txt "remove zunearc: rc=$RC"
Echo >>RAM:L/c.txt "*N==== List SYS:Batch ALL"
List >>RAM:L/c.txt SYS:Batch ALL
Echo >>RAM:L/c.txt "*N==== apkg list"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch list
Date >>RAM:L/c.txt
RAM:b/putfile >NIL: RAM:L/c.txt c.txt 8803
Echo >RAM:L/end.txt "end"
RAM:b/putfile >NIL: RAM:L/end.txt end.txt 8803

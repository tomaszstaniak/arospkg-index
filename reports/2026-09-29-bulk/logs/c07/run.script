  Echo >>RAM:L/b-timeit.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-timeit.txt COMMAND=TimeIt
  If EXISTS RAM:L/r-timeit.txt
    Type >>RAM:L/b-timeit.txt RAM:L/r-timeit.txt
  EndIf
EndIf
Echo >RAM:L/m "timeit"
RAM:b/putfile >NIL: RAM:L/m shot-timeit 8807
Wait 4
Status >NIL: COMMAND=TimeIt
If NOT WARN
  Break >NIL: `Status COMMAND=TimeIt` C
  Wait 5
EndIf
Echo >>RAM:L/b-timeit.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-timeit.txt COMMAND=TimeIt
If EXISTS RAM:L/r-timeit.txt
  Type >>RAM:L/b-timeit.txt RAM:L/r-timeit.txt
EndIf
Date >>RAM:L/b-timeit.txt
RAM:b/putfile >NIL: RAM:L/b-timeit.txt b-timeit.txt 8807
If EXISTS RAM:L/o-timeit.txt
RAM:b/putfile >NIL: RAM:L/o-timeit.txt o-timeit.txt 8807
EndIf
RAM:b/putfile >NIL: RAM:L/m done-timeit 8807
Wait 3
Echo >RAM:L/b-untarka.txt "==== untarka: UnTarka, stack 40960"
Date >>RAM:L/b-untarka.txt
If NOT EXISTS SYS:Batch/untarka
  Echo >>RAM:L/b-untarka.txt "untarka: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start untarka "SYS:Batch/untarka" UnTarka 40960
  Wait 15
  Echo >>RAM:L/b-untarka.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-untarka.txt COMMAND=UnTarka
  If EXISTS RAM:L/r-untarka.txt
    Type >>RAM:L/b-untarka.txt RAM:L/r-untarka.txt
  EndIf
EndIf
Echo >RAM:L/m "untarka"
RAM:b/putfile >NIL: RAM:L/m shot-untarka 8807
Wait 4
Status >NIL: COMMAND=UnTarka
If NOT WARN
  Break >NIL: `Status COMMAND=UnTarka` C
  Wait 5
EndIf
Echo >>RAM:L/b-untarka.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-untarka.txt COMMAND=UnTarka
If EXISTS RAM:L/r-untarka.txt
  Type >>RAM:L/b-untarka.txt RAM:L/r-untarka.txt
EndIf
Date >>RAM:L/b-untarka.txt
RAM:b/putfile >NIL: RAM:L/b-untarka.txt b-untarka.txt 8807
If EXISTS RAM:L/o-untarka.txt
RAM:b/putfile >NIL: RAM:L/o-untarka.txt o-untarka.txt 8807
EndIf
RAM:b/putfile >NIL: RAM:L/m done-untarka 8807
Wait 3
Echo >RAM:L/c.txt "==== stage C: remove"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove amishockolate
Echo >>RAM:L/c.txt "remove amishockolate: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove apotris
Echo >>RAM:L/c.txt "remove apotris: rc=$RC"

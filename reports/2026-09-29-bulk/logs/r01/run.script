  Status >>RAM:L/b-fheroes2.txt COMMAND=fheroes2
  If EXISTS RAM:L/r-fheroes2.txt
    Type >>RAM:L/b-fheroes2.txt RAM:L/r-fheroes2.txt
  EndIf
EndIf
Echo >RAM:L/m "fheroes2"
RAM:b/putfile >NIL: RAM:L/m shot-fheroes2 8801
Wait 4
Status >NIL: COMMAND=fheroes2
If NOT WARN
  Break >NIL: `Status COMMAND=fheroes2` C
  Wait 5
EndIf
Echo >>RAM:L/b-fheroes2.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-fheroes2.txt COMMAND=fheroes2
If EXISTS RAM:L/r-fheroes2.txt
  Type >>RAM:L/b-fheroes2.txt RAM:L/r-fheroes2.txt
EndIf
Date >>RAM:L/b-fheroes2.txt
RAM:b/putfile >NIL: RAM:L/b-fheroes2.txt b-fheroes2.txt 8801
If EXISTS RAM:L/o-fheroes2.txt
RAM:b/putfile >NIL: RAM:L/o-fheroes2.txt o-fheroes2.txt 8801
EndIf
RAM:b/putfile >NIL: RAM:L/m done-fheroes2 8801
Wait 3
Echo >RAM:L/b-hexen2.txt "==== hexen2: Hexen2, stack 2000000"
Date >>RAM:L/b-hexen2.txt
If NOT EXISTS SYS:Batch/hexen2
  Echo >>RAM:L/b-hexen2.txt "hexen2: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start hexen2 "SYS:Batch/hexen2" Hexen2 2000000
  Wait 15
  Echo >>RAM:L/b-hexen2.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-hexen2.txt COMMAND=Hexen2
  If EXISTS RAM:L/r-hexen2.txt
    Type >>RAM:L/b-hexen2.txt RAM:L/r-hexen2.txt
  EndIf
EndIf
Echo >RAM:L/m "hexen2"
RAM:b/putfile >NIL: RAM:L/m shot-hexen2 8801
Wait 4
Status >NIL: COMMAND=Hexen2
If NOT WARN
  Break >NIL: `Status COMMAND=Hexen2` C
  Wait 5
EndIf
Echo >>RAM:L/b-hexen2.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-hexen2.txt COMMAND=Hexen2
If EXISTS RAM:L/r-hexen2.txt
  Type >>RAM:L/b-hexen2.txt RAM:L/r-hexen2.txt
EndIf
Date >>RAM:L/b-hexen2.txt
RAM:b/putfile >NIL: RAM:L/b-hexen2.txt b-hexen2.txt 8801
If EXISTS RAM:L/o-hexen2.txt
RAM:b/putfile >NIL: RAM:L/o-hexen2.txt o-hexen2.txt 8801
EndIf
RAM:b/putfile >NIL: RAM:L/m done-hexen2 8801
Wait 3
Echo >RAM:L/b-mplayer.txt "==== mplayer: MPlayer, stack 512000"
Date >>RAM:L/b-mplayer.txt
If NOT EXISTS SYS:Batch/mplayer
  Echo >>RAM:L/b-mplayer.txt "mplayer: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start mplayer "SYS:Batch/mplayer" MPlayer 512000
  Wait 15
  Echo >>RAM:L/b-mplayer.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-mplayer.txt COMMAND=MPlayer
  If EXISTS RAM:L/r-mplayer.txt
    Type >>RAM:L/b-mplayer.txt RAM:L/r-mplayer.txt
  EndIf
EndIf
Echo >RAM:L/m "mplayer"
RAM:b/putfile >NIL: RAM:L/m shot-mplayer 8801
Wait 4
Status >NIL: COMMAND=MPlayer
If NOT WARN
  Break >NIL: `Status COMMAND=MPlayer` C
  Wait 5
EndIf
Echo >>RAM:L/b-mplayer.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-mplayer.txt COMMAND=MPlayer
If EXISTS RAM:L/r-mplayer.txt
  Type >>RAM:L/b-mplayer.txt RAM:L/r-mplayer.txt
EndIf
Date >>RAM:L/b-mplayer.txt
RAM:b/putfile >NIL: RAM:L/b-mplayer.txt b-mplayer.txt 8801
If EXISTS RAM:L/o-mplayer.txt
RAM:b/putfile >NIL: RAM:L/o-mplayer.txt o-mplayer.txt 8801
EndIf
RAM:b/putfile >NIL: RAM:L/m done-mplayer 8801
Wait 3
Echo >RAM:L/b-playsid-gui.txt "==== playsid-gui: PlaySID-GUI, stack 40960"
Date >>RAM:L/b-playsid-gui.txt
If NOT EXISTS SYS:Batch/playsid-gui
  Echo >>RAM:L/b-playsid-gui.txt "playsid-gui: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start playsid-gui "SYS:Batch/playsid-gui" PlaySID-GUI 40960
  Wait 15
  Echo >>RAM:L/b-playsid-gui.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-playsid-gui.txt COMMAND=PlaySID-GUI
  If EXISTS RAM:L/r-playsid-gui.txt
    Type >>RAM:L/b-playsid-gui.txt RAM:L/r-playsid-gui.txt
  EndIf
EndIf
Echo >RAM:L/m "playsid-gui"
RAM:b/putfile >NIL: RAM:L/m shot-playsid-gui 8801
Wait 4
Status >NIL: COMMAND=PlaySID-GUI
If NOT WARN
  Break >NIL: `Status COMMAND=PlaySID-GUI` C
  Wait 5
EndIf
Echo >>RAM:L/b-playsid-gui.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-playsid-gui.txt COMMAND=PlaySID-GUI
If EXISTS RAM:L/r-playsid-gui.txt
  Type >>RAM:L/b-playsid-gui.txt RAM:L/r-playsid-gui.txt
EndIf
Date >>RAM:L/b-playsid-gui.txt
RAM:b/putfile >NIL: RAM:L/b-playsid-gui.txt b-playsid-gui.txt 8801
If EXISTS RAM:L/o-playsid-gui.txt
RAM:b/putfile >NIL: RAM:L/o-playsid-gui.txt o-playsid-gui.txt 8801
EndIf
RAM:b/putfile >NIL: RAM:L/m done-playsid-gui 8801
Wait 3
Echo >RAM:L/b-sokobangp2x.txt "==== sokobangp2x: Sokoban, stack 1000000"
Date >>RAM:L/b-sokobangp2x.txt
If NOT EXISTS SYS:Batch/sokobangp2x

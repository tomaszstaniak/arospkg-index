; arospkg 0.4.2 after publication: self-update from 0.4.1, install through the candidate catalogue
FAILAT 1000
Delete RAM:su RAM:cat RAM:old ALL FORCE QUIET
MakeDir RAM:su
MakeDir RAM:cat
MakeDir RAM:old
Copy SYS:P42/apkg041 RAM:su/apkg
Protect RAM:su/apkg +e
Protect SYS:P42/apkg032 +e
RAM:su/apkg --version >RESULTS:p42-01-version041.txt
Echo >>RESULTS:p42-01-version041.txt "rc=$RC"
RAM:su/apkg self-update --check >RESULTS:p42-02-check.txt
Echo >>RESULTS:p42-02-check.txt "rc=$RC"
RAM:su/apkg --plain self-update >RESULTS:p42-03-selfupdate.txt
Echo >>RESULTS:p42-03-selfupdate.txt "rc=$RC"
RAM:su/apkg --version >RESULTS:p42-04-version.txt
Echo >>RESULTS:p42-04-version.txt "rc=$RC"
List RAM:su >RESULTS:p42-05-list-su.txt
Echo >>RESULTS:p42-05-list-su.txt "rc=$RC"
RAM:su/apkg --root RAM:cat --index SYS:P42/index-v2.json show arospkg >RESULTS:p42-06-show.txt
Echo >>RESULTS:p42-06-show.txt "rc=$RC"
RAM:su/apkg --root RAM:cat --index SYS:P42/index-v2.json --plain install arospkg >RESULTS:p42-07-install.txt
Echo >>RESULTS:p42-07-install.txt "rc=$RC"
RAM:cat/arospkg-0.4.2.x86_64-aros-v11/apkg --version >RESULTS:p42-08-started.txt
Echo >>RESULTS:p42-08-started.txt "rc=$RC"
RAM:su/apkg --root RAM:cat --index SYS:P42/index-v2.json verify arospkg >RESULTS:p42-09-verify.txt
Echo >>RESULTS:p42-09-verify.txt "rc=$RC"
RAM:su/apkg --root RAM:cat --index SYS:P42/index-v2.json outdated --all >RESULTS:p42-10-outdated.txt
Echo >>RESULTS:p42-10-outdated.txt "rc=$RC"
RAM:su/apkg --root RAM:cat --index SYS:P42/index-v2.json remove arospkg >RESULTS:p42-11-remove.txt
Echo >>RESULTS:p42-11-remove.txt "rc=$RC"
SYS:P42/apkg032 --version >RESULTS:p42-12-old-version.txt
Echo >>RESULTS:p42-12-old-version.txt "rc=$RC"
SYS:P42/apkg032 --root RAM:old --index SYS:P42/index.json search arospkg >RESULTS:p42-13-old-search.txt
Echo >>RESULTS:p42-13-old-search.txt "rc=$RC"
SYS:P42/apkg032 --root RAM:old --index SYS:P42/index.json install arospkg >RESULTS:p42-14-old-install.txt
Echo >>RESULTS:p42-14-old-install.txt "rc=$RC"
RAM:old/arospkg-0.4.2.x86_64-aros-v11/apkg --version >RESULTS:p42-15-old-started.txt
Echo >>RESULTS:p42-15-old-started.txt "rc=$RC"
SYS:P42/apkg032 --root RAM:old --index SYS:P42/index.json remove arospkg >RESULTS:p42-16-old-remove.txt
Echo >>RESULTS:p42-16-old-remove.txt "rc=$RC"
Echo >RESULTS:p42-done.txt "done"

Echo >RAM:L/b-alac.txt "==== alac: ALAC, stack 40960"
Date >>RAM:L/b-alac.txt
If NOT EXISTS SYS:Batch/alac
  Echo >>RAM:L/b-alac.txt "alac: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start alac "SYS:Batch/alac" ALAC 40960
  Wait 15
  Echo >>RAM:L/b-alac.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-alac.txt COMMAND=ALAC
  If EXISTS RAM:L/r-alac.txt
    Type >>RAM:L/b-alac.txt RAM:L/r-alac.txt
  EndIf
EndIf
Echo >RAM:L/m "alac"
RAM:b/putfile >NIL: RAM:L/m shot-alac 8809
Wait 4
Status >NIL: COMMAND=ALAC
If NOT WARN
  Break >NIL: `Status COMMAND=ALAC` C
  Wait 5
EndIf
Echo >>RAM:L/b-alac.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-alac.txt COMMAND=ALAC
If EXISTS RAM:L/r-alac.txt
  Type >>RAM:L/b-alac.txt RAM:L/r-alac.txt
EndIf
Date >>RAM:L/b-alac.txt
RAM:b/putfile >NIL: RAM:L/b-alac.txt b-alac.txt 8809
If EXISTS RAM:L/o-alac.txt
RAM:b/putfile >NIL: RAM:L/o-alac.txt o-alac.txt 8809
EndIf
RAM:b/putfile >NIL: RAM:L/m done-alac 8809
Wait 3

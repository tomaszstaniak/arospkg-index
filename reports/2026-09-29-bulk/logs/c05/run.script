; Batch script for one test machine; run with Execute RAM:b/run
FAILAT 1000
Protect RAM:b/apkg +e
Protect RAM:b/putfile +e
MakeDir RAM:L
Echo >RAM:L/net.txt "network"
Lab net
RAM:b/putfile >RAM:L/netlog RAM:L/net.txt net.txt 8805
If WARN
  Wait 10
  Skip net BACK
EndIf
Echo >RAM:L/env.txt "apkg:"
List >>RAM:L/env.txt RAM:b/apkg LFORMAT="%n %l"
RAM:b/apkg >>RAM:L/env.txt --version
Version >>RAM:L/env.txt
Date >>RAM:L/env.txt
Avail >>RAM:L/env.txt
Stack >>RAM:L/env.txt
RAM:b/putfile >NIL: RAM:L/env.txt env.txt 8805
Echo >RAM:L/a.txt "==== stage A: install"
Echo >>RAM:L/a.txt "*N==== adoom3"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install adoom3
Echo >>RAM:L/a.txt "install adoom3: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info adoom3
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8805
Echo >>RAM:L/a.txt "*N==== boy"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install boy
Echo >>RAM:L/a.txt "install boy: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info boy
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8805
Echo >>RAM:L/a.txt "*N==== cabextract"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install cabextract
Echo >>RAM:L/a.txt "install cabextract: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info cabextract
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8805
Echo >>RAM:L/a.txt "*N==== dclock"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install dclock
Echo >>RAM:L/a.txt "install dclock: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info dclock
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8805
Echo >>RAM:L/a.txt "*N==== demoeffects"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install demoeffects
Echo >>RAM:L/a.txt "install demoeffects: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info demoeffects
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8805
Echo >>RAM:L/a.txt "*N==== keen4"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install keen4
Echo >>RAM:L/a.txt "install keen4: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info keen4
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8805
Echo >>RAM:L/a.txt "*N==== mcamiga"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install mcamiga
Echo >>RAM:L/a.txt "install mcamiga: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info mcamiga
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8805

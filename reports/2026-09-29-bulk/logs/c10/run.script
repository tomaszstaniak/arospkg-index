; Batch script for one test machine; run with Execute RAM:b/run
FAILAT 1000
Protect RAM:b/apkg +e
Protect RAM:b/putfile +e
MakeDir RAM:L
Echo >RAM:L/net.txt "network"
Lab net
RAM:b/putfile >RAM:L/netlog RAM:L/net.txt net.txt 8810
If WARN
  Wait 10
  Skip net BACK
EndIf
Echo >RAM:L/env.txt "apkg:"
List >>RAM:L/env.txt RAM:b/apkg LFORMAT="%n %l"
RAM:b/apkg >>RAM:L/env.txt --version
Version >>RAM:L/env.txt
Date >>RAM:L/env.txt
Avail >>RAM:L/env.txt
Stack >>RAM:L/env.txt
RAM:b/putfile >NIL: RAM:L/env.txt env.txt 8810
Echo >RAM:L/a.txt "==== stage A: install"
Echo >>RAM:L/a.txt "*N==== ccd2cue"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install ccd2cue
Echo >>RAM:L/a.txt "install ccd2cue: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info ccd2cue
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8810
Echo >>RAM:L/a.txt "*N==== ffmpegvideotool"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install ffmpegvideotool
Echo >>RAM:L/a.txt "install ffmpegvideotool: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info ffmpegvideotool
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8810

Echo >RAM:L/b-delugem.txt "==== delugem: delugem, stack 400000"
Date >>RAM:L/b-delugem.txt
If NOT EXISTS SYS:Batch/delugem
  Echo >>RAM:L/b-delugem.txt "delugem: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start delugem "SYS:Batch/delugem" delugem 400000
  Wait 15
  Echo >>RAM:L/b-delugem.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-delugem.txt COMMAND=delugem
  If EXISTS RAM:L/r-delugem.txt
    Type >>RAM:L/b-delugem.txt RAM:L/r-delugem.txt
  EndIf
EndIf
Echo >RAM:L/m "delugem"
RAM:b/putfile >NIL: RAM:L/m shot-delugem 8804
Wait 4
Status >NIL: COMMAND=delugem
If NOT WARN
  Break >NIL: `Status COMMAND=delugem` C
  Wait 5
EndIf
Echo >>RAM:L/b-delugem.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-delugem.txt COMMAND=delugem
If EXISTS RAM:L/r-delugem.txt
  Type >>RAM:L/b-delugem.txt RAM:L/r-delugem.txt
EndIf
Date >>RAM:L/b-delugem.txt
RAM:b/putfile >NIL: RAM:L/b-delugem.txt b-delugem.txt 8804
If EXISTS RAM:L/o-delugem.txt
RAM:b/putfile >NIL: RAM:L/o-delugem.txt o-delugem.txt 8804
EndIf
RAM:b/putfile >NIL: RAM:L/m done-delugem 8804
Wait 3

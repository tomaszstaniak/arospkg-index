If EXISTS RAM:L/o-tbftss.txt
RAM:b/putfile >NIL: RAM:L/o-tbftss.txt o-tbftss.txt 8801
EndIf
RAM:b/putfile >NIL: RAM:L/m done-tbftss 8801
Wait 3
Echo >RAM:L/c.txt "==== stage C: remove"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove ab3dhd
Echo >>RAM:L/c.txt "remove ab3dhd: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove davegnukem
Echo >>RAM:L/c.txt "remove davegnukem: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove fheroes2
Echo >>RAM:L/c.txt "remove fheroes2: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove hexen2
Echo >>RAM:L/c.txt "remove hexen2: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove mplayer
Echo >>RAM:L/c.txt "remove mplayer: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove playsid-gui

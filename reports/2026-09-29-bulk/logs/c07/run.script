RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install breakhack
Echo >>RAM:L/a.txt "install breakhack: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info breakhack
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8807
Echo >>RAM:L/a.txt "*N==== dose2"

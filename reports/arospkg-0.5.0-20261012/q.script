failat 21
makedir RAM:su
copy SYS:Q5/o42/apkg RAM:su/apkg
protect RAM:su/apkg +e
RAM:su/apkg --version >RESULTS:q50-01-old.txt
RAM:su/apkg --root RAM:sr self-update >RESULTS:q50-02-selfupdate.txt
echo "rc $RC" >>RESULTS:q50-02-selfupdate.txt
RAM:su/apkg --version >RESULTS:q50-03-new.txt
RAM:su/apkg --root RAM:cat --index SYS:Q5/idx-v2.json install arospkg >RESULTS:q50-04-install.txt
echo "rc $RC" >>RESULTS:q50-04-install.txt
RAM:cat/arospkg/apkg --version >RESULTS:q50-05-installed.txt
echo done >RESULTS:q50-99-done.txt

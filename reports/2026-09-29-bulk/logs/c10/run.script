RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8810
Echo >>RAM:L/a.txt "*N==== leu"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install leu
Echo >>RAM:L/a.txt "install leu: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info leu
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8810
Echo >>RAM:L/a.txt "*N==== minislug"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install minislug
Echo >>RAM:L/a.txt "install minislug: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info minislug
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8810

Echo >>RAM:L/a.txt "install wildmidi: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info wildmidi
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8810
Echo >RAM:L/b-ccd2cue.txt "==== ccd2cue: Ccd2Cue, stack 40960"
Date >>RAM:L/b-ccd2cue.txt
If NOT EXISTS SYS:Batch/ccd2cue
  Echo >>RAM:L/b-ccd2cue.txt "ccd2cue: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start ccd2cue "SYS:Batch/ccd2cue" Ccd2Cue 40960
  Wait 15
  Echo >>RAM:L/b-ccd2cue.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-ccd2cue.txt COMMAND=Ccd2Cue
  If EXISTS RAM:L/r-ccd2cue.txt
    Type >>RAM:L/b-ccd2cue.txt RAM:L/r-ccd2cue.txt
  EndIf
EndIf
Echo >RAM:L/m "ccd2cue"
RAM:b/putfile >NIL: RAM:L/m shot-ccd2cue 8810
Wait 4
Status >NIL: COMMAND=Ccd2Cue
If NOT WARN
  Break >NIL: `Status COMMAND=Ccd2Cue` C
  Wait 5
EndIf
Echo >>RAM:L/b-ccd2cue.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-ccd2cue.txt COMMAND=Ccd2Cue
If EXISTS RAM:L/r-ccd2cue.txt
  Type >>RAM:L/b-ccd2cue.txt RAM:L/r-ccd2cue.txt
EndIf
Date >>RAM:L/b-ccd2cue.txt
RAM:b/putfile >NIL: RAM:L/b-ccd2cue.txt b-ccd2cue.txt 8810
If EXISTS RAM:L/o-ccd2cue.txt
RAM:b/putfile >NIL: RAM:L/o-ccd2cue.txt o-ccd2cue.txt 8810
EndIf
RAM:b/putfile >NIL: RAM:L/m done-ccd2cue 8810

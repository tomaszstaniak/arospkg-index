; Batch script for one test machine; run with Execute RAM:b/run
FAILAT 1000
Protect RAM:b/apkg +e
Protect RAM:b/putfile +e
MakeDir RAM:L
Echo >RAM:L/net.txt "network"
Lab net
RAM:b/putfile >RAM:L/netlog RAM:L/net.txt net.txt 8801
If WARN
  Wait 10
  Skip net BACK
EndIf
Echo >RAM:L/env.txt "apkg:"
List >>RAM:L/env.txt RAM:b/apkg LFORMAT="%n %l"
RAM:b/apkg >>RAM:L/env.txt --version
Version >>RAM:L/env.txt
Date >>RAM:L/env.txt
Avail >>RAM:L/env.txt
Stack >>RAM:L/env.txt
RAM:b/putfile >NIL: RAM:L/env.txt env.txt 8801
Echo >RAM:L/a.txt "==== stage A: install"
Echo >>RAM:L/a.txt "*N==== ab3dhd"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install ab3dhd
Echo >>RAM:L/a.txt "install ab3dhd: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info ab3dhd
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8801
Echo >>RAM:L/a.txt "*N==== davegnukem"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install davegnukem
Echo >>RAM:L/a.txt "install davegnukem: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info davegnukem
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8801
Echo >>RAM:L/a.txt "*N==== fheroes2"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install fheroes2
Echo >>RAM:L/a.txt "install fheroes2: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info fheroes2
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8801
Echo >>RAM:L/a.txt "*N==== hexen2"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install hexen2
Echo >>RAM:L/a.txt "install hexen2: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info hexen2
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8801
Echo >>RAM:L/a.txt "*N==== mplayer"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install mplayer
Echo >>RAM:L/a.txt "install mplayer: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info mplayer
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8801
Echo >>RAM:L/a.txt "*N==== playsid-gui"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install playsid-gui
Echo >>RAM:L/a.txt "install playsid-gui: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info playsid-gui
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8801
Echo >>RAM:L/a.txt "*N==== sokobangp2x"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install sokobangp2x
Echo >>RAM:L/a.txt "install sokobangp2x: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info sokobangp2x
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8801
Echo >>RAM:L/a.txt "*N==== tbftss"
Date >>RAM:L/a.txt
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install tbftss
Echo >>RAM:L/a.txt "install tbftss: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info tbftss
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8801
Echo >RAM:L/b-ab3dhd.txt "==== ab3dhd: ab3d1, stack 500000"
Date >>RAM:L/b-ab3dhd.txt
If NOT EXISTS SYS:Batch/ab3dhd
  Echo >>RAM:L/b-ab3dhd.txt "ab3dhd: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start ab3dhd "SYS:Batch/ab3dhd" ab3d1 500000
  Wait 15
  Echo >>RAM:L/b-ab3dhd.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-ab3dhd.txt COMMAND=ab3d1
  If EXISTS RAM:L/r-ab3dhd.txt
    Type >>RAM:L/b-ab3dhd.txt RAM:L/r-ab3dhd.txt
  EndIf
EndIf
Echo >RAM:L/m "ab3dhd"
RAM:b/putfile >NIL: RAM:L/m shot-ab3dhd 8801
Wait 4
Status >NIL: COMMAND=ab3d1
If NOT WARN
  Break >NIL: `Status COMMAND=ab3d1` C
  Wait 5
EndIf
Echo >>RAM:L/b-ab3dhd.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-ab3dhd.txt COMMAND=ab3d1
If EXISTS RAM:L/r-ab3dhd.txt
  Type >>RAM:L/b-ab3dhd.txt RAM:L/r-ab3dhd.txt
EndIf
Date >>RAM:L/b-ab3dhd.txt
RAM:b/putfile >NIL: RAM:L/b-ab3dhd.txt b-ab3dhd.txt 8801
If EXISTS RAM:L/o-ab3dhd.txt
RAM:b/putfile >NIL: RAM:L/o-ab3dhd.txt o-ab3dhd.txt 8801
EndIf
RAM:b/putfile >NIL: RAM:L/m done-ab3dhd 8801
Wait 3
Echo >RAM:L/b-davegnukem.txt "==== davegnukem: davegnukem, stack 40960"
Date >>RAM:L/b-davegnukem.txt
If NOT EXISTS SYS:Batch/davegnukem
  Echo >>RAM:L/b-davegnukem.txt "davegnukem: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start davegnukem "SYS:Batch/davegnukem" davegnukem 40960
  Wait 15
  Echo >>RAM:L/b-davegnukem.txt "after 15 s (a number means it is running):"
  Status >>RAM:L/b-davegnukem.txt COMMAND=davegnukem
  If EXISTS RAM:L/r-davegnukem.txt
    Type >>RAM:L/b-davegnukem.txt RAM:L/r-davegnukem.txt
  EndIf
EndIf
Echo >RAM:L/m "davegnukem"
RAM:b/putfile >NIL: RAM:L/m shot-davegnukem 8801
Wait 4
Status >NIL: COMMAND=davegnukem
If NOT WARN
  Break >NIL: `Status COMMAND=davegnukem` C
  Wait 5
EndIf
Echo >>RAM:L/b-davegnukem.txt "after Ctrl-C (empty means it has ended):"
Status >>RAM:L/b-davegnukem.txt COMMAND=davegnukem
If EXISTS RAM:L/r-davegnukem.txt
  Type >>RAM:L/b-davegnukem.txt RAM:L/r-davegnukem.txt
EndIf
Date >>RAM:L/b-davegnukem.txt
RAM:b/putfile >NIL: RAM:L/b-davegnukem.txt b-davegnukem.txt 8801
If EXISTS RAM:L/o-davegnukem.txt
RAM:b/putfile >NIL: RAM:L/o-davegnukem.txt o-davegnukem.txt 8801
EndIf
RAM:b/putfile >NIL: RAM:L/m done-davegnukem 8801
Wait 3
Echo >RAM:L/b-fheroes2.txt "==== fheroes2: fheroes2, stack 200000"
Date >>RAM:L/b-fheroes2.txt
If NOT EXISTS SYS:Batch/fheroes2
  Echo >>RAM:L/b-fheroes2.txt "fheroes2: not installed, not started"
Else
  Run >NIL: <NIL: Execute RAM:b/start fheroes2 "SYS:Batch/fheroes2" fheroes2 200000

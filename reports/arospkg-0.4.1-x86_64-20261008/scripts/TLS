; TLS series: 30 installs of arospkg 0.4.1 from its GitHub release on fresh roots.
; Each try logs guest time before and after, the exit code and the full output
; (--verbose shows each redirect hop), and sends a marker to the host so that
; the host records its own time of arrival.
FAILAT 1000
Delete RAM:tls.log QUIET
Copy PAYLOAD:IDXPUB RAM:idxpub.json
Copy PAYLOAD:PUTFILE RAM:putfile
Protect RAM:putfile +e
Echo >RAM:m "tls start"
RAM:putfile RAM:m tls-1008b-00-start 8765 >>RAM:tls.log
Delete RAM:tl ALL FORCE QUIET
MakeDir RAM:tl
Echo >>RAM:tls.log "== try 01 =="
Date >>RAM:tls.log
RAM:rel/arospkg-0.4.1.x86_64-aros-v11/apkg --verbose --root RAM:tl --index RAM:idxpub.json install arospkg >>RAM:tls.log
Set r $RC
Echo >>RAM:tls.log "rc=$r"
Date >>RAM:tls.log
Echo >RAM:m "try 01 rc=$r"
RAM:putfile RAM:m tls-1008b-01 8765 >>RAM:tls.log
Delete RAM:tl ALL FORCE QUIET
MakeDir RAM:tl

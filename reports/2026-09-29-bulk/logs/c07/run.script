RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch --index RAM:b/index.json install dose2
Echo >>RAM:L/a.txt "install dose2: rc=$RC"
RAM:b/apkg >>RAM:L/a.txt --root SYS:Batch info dose2
RAM:b/putfile >NIL: RAM:L/a.txt a.txt 8807

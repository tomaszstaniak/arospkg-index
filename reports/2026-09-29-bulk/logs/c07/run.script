Echo >>RAM:L/c.txt "remove breakhack: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove dose2
Echo >>RAM:L/c.txt "remove dose2: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove ft2clone
Echo >>RAM:L/c.txt "remove ft2clone: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove lzop
Echo >>RAM:L/c.txt "remove lzop: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove planethively
Echo >>RAM:L/c.txt "remove planethively: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove potrace
Echo >>RAM:L/c.txt "remove potrace: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove rtf-riddle
Echo >>RAM:L/c.txt "remove rtf-riddle: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove sfsobject
Echo >>RAM:L/c.txt "remove sfsobject: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove timeit
Echo >>RAM:L/c.txt "remove timeit: rc=$RC"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch remove untarka
Echo >>RAM:L/c.txt "remove untarka: rc=$RC"
Echo >>RAM:L/c.txt "*N==== List SYS:Batch ALL"
List >>RAM:L/c.txt SYS:Batch ALL
Echo >>RAM:L/c.txt "*N==== apkg list"
RAM:b/apkg >>RAM:L/c.txt --root SYS:Batch list
Date >>RAM:L/c.txt
RAM:b/putfile >NIL: RAM:L/c.txt c.txt 8807
Echo >RAM:L/end.txt "end"
